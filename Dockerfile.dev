FROM php:8.2-apache

RUN apt-get update && apt-get install -y \
        libicu-dev \
        libldap2-dev \
        libzip-dev \
        libpng-dev \
        libjpeg62-turbo-dev \
        libfreetype6-dev \
        unzip \
        git \
    && docker-php-ext-configure ldap --with-libdir=lib/x86_64-linux-gnu \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j"$(nproc)" intl ldap mysqli pdo pdo_mysql zip gd bcmath \
    && a2enmod rewrite \
    && sed -i 's/AllowOverride None/AllowOverride All/' /etc/apache2/apache2.conf \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# On Windows, the project is bind-mounted into the container (docker-compose.dev.yml
# ".:/var/www/html"), and every filesystem call across that bind mount is slow.
# opcache's default per-request timestamp check (one stat() per included file) on an
# app that require_once's 300+ PHP files per request turns into multi-second page
# loads. Disabling it removes that stat() cost entirely.
# Trade-off: PHP source edits won't be picked up until opcache is cleared, e.g.
# `docker compose -f docker-compose.dev.yml restart app`.
RUN echo 'opcache.validate_timestamps=0' > /usr/local/etc/php/conf.d/zz-opcache-dev.ini

# Configured logging.folder — Monolog's StreamHandler can't mkdir under the
# root-owned /var/log at runtime. It happens to already exist in the current
# dev container, but bake it in so a fresh build isn't silently log-less.
RUN mkdir -p /var/log/librebooking/log && chown -R www-data:www-data /var/log/librebooking

WORKDIR /var/www/html
