booking.coasia.com.tw {
    reverse_proxy app:80
}

# If booking.coasia.com.tw does NOT resolve from the public internet, automatic
# Let's Encrypt (above) cannot complete its challenge and this block will fail.
# In that case, comment out the block above and use one of these instead:
#
# Option A: internal CA (e.g. AD CS) issued certificate files
# booking.coasia.com.tw {
#     tls /etc/caddy/certs/booking.crt /etc/caddy/certs/booking.key
#     reverse_proxy app:80
# }
# (also add a matching volume mount for ./certs:/etc/caddy/certs:ro in docker-compose.prod.yml)
#
# Option B: Caddy's own local CA, trusted manually on client machines
# booking.coasia.com.tw {
#     tls internal
#     reverse_proxy app:80
# }
