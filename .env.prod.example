# Copy this file to .env (same directory as docker-compose.prod.yml) on the
# production VM and fill in real values. This file is read by `docker compose`
# itself (for ${MYSQL_*} substitution in docker-compose.prod.yml) — it is a
# different file from app.env, which holds the application's own LB_-prefixed
# settings (see .env.example) and gets mounted into the app container.
#
# Never commit the real .env — it already matches the repo's existing
# `.env` gitignore rule.

MYSQL_DATABASE=librebooking
MYSQL_USER=lb_user
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

# From Cloudflare Zero Trust: Networks > Tunnels > (your tunnel) > Configure
# > Docker install command -- copy just the token value (the string after
# "tunnel run --token").
CLOUDFLARE_TUNNEL_TOKEN=change-me
