/vendor/*
/node_modules/

/build/*
/tools/*
/var/*

# Customized Configuration Files
/config/config.php
/config/config_*.bck.php
/config/log4php.config.xml
/config/custom-version.txt
/config/version-suffix.txt
**/*.config.php

/lib/external/phpqrcode/cache/*
!/lib/external/phpqrcode/cache/index.html

/plugins/*
!/plugins/Authentication
!/plugins/**/index.html
!/plugins/**/*Example/*

# Smarty Cache / compiled templates
/tpl_c/*
!/tpl_c/index.html

# Customization Files
/Web/custom-favicon.png
/Web/img/custom-logo.png
# This fork is CoAsia-specific, so its actual brand logo/favicon should ship with the repo.
!/Web/img/custom-logo.png
!/Web/custom-favicon.png
!/Web/custom-favicon.ico
lang/*/*-custom.tpl

# Upload Directories
/uploads/*
!/uploads/index.html

/Web/uploads/images/*
!/Web/uploads/images/index.html
/Web/uploads/tos/*
!/Web/uploads/tos/index.html

/Web/test-embed.html

# /phpunit.xml.dist is tracked
/phpunit.xml

# /.php-cs-fixer.dist.php is tracked
.php-cs-fixer.php

/.phpdoc
# /phpdoc.dist.xml is tracked
/phpdoc.xml

# Editor Cache Files
.idea

.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

*.sublime-workspace

.DS_Store

# php8 phpcompatibility report
php8-report.log

# phpunit cache
.phpunit.cache/
.env
app.env
/certs/

# Database dumps (may contain real employee data) — never commit these
*.sql
# ...except the tracked schema/migration scripts and test fixtures, which are
# code, not dumps. Without this, `git add .` after adding a new
# database_schema/upgrades/X.Y/ folder silently drops it (every existing
# upgrades/*.sql got into git via `git add -f`, masking this gap).
!/database_schema/**/*.sql
!/tests/load_test.sql
